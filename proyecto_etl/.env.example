# Copiar a .env y completar. El archivo .env NO se entrega ni se versiona.
AIRFLOW_UID=50000
POSTGRES_USER=etl
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=dw_gestion
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambiar_esta_clave
# Credenciales de API (Airflow Variables vía AIRFLOW_VAR_*)
# Token de la API del BCCh (entre comillas simples: contiene '$')
BCCH_TOKEN='token_api_bcch'
MP_TICKET=ticket_mercado_publico
# Clave para cifrar Variables y Connections guardadas en la BD de Airflow.
# Generarla UNA sola vez (ver README) y no cambiarla después.
AIRFLOW_FERNET_KEY=
