# copiar a .env y completar. el archivo .env no se entrega ni se versiona.
AIRFLOW_UID=50000
POSTGRES_USER=etl
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=etl_bcc
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambiar_esta_clave
# credenciales de api: airflow-init las registra como variables de airflow (mp_ticket, bcch_user, bcch_password)
# usuario (correo) y clave de la api del bcch; si la clave contiene '$', escribirla entre comillas simples
BCCH_USER=correo_registrado_en_el_bcch
BCCH_PASS=clave_api_bcch
MP_TICKET=ticket_mercado_publico
# clave para cifrar variables y connections guardadas en la bd de airflow.
# generarla una sola vez (ver readme) y no cambiarla despues.
AIRFLOW_FERNET_KEY=
# secreto compartido entre los componentes de airflow 3 (ver readme para generarlo)
AIRFLOW_JWT_SECRET=
